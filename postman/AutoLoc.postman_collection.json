				{
					"name": "Créer un contrat avec ses paiements (Cascade)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02T10:00:00\",\n    \"montantTotal\": 480.00,\n    \"valide\": true,\n    \"paiements\": [\n        { \"montant\": 150.00, \"datePaiement\": \"2026-11-02T11:00:00\", \"modePaiement\": \"CARTE\" },\n        { \"montant\": 330.00, \"datePaiement\": \"2026-11-06T14:30:00\", \"modePaiement\": \"VIREMENT\" }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201\", () => pm.response.to.have.status(201));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Modifier un contrat",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02T10:00:00\",\n    \"montantTotal\": 520.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats", "{{contratId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Montant mis à jour\", () => {",
									"    pm.expect(pm.response.json().montantTotal).to.eql(520.00);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Supprimer un contrat",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats", "{{contratId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 204\", () => pm.response.to.have.status(204));"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
