	"item": [
		{
			"name": "Contrats",
			"item": [
				{
					"name": "Lister les contrats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Consulter un contrat inexistant (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/contrats/9999",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats", "9999"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 404\", () => pm.response.to.have.status(404));",
									"pm.test(\"Corps d'erreur JSON avec statut\", () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.statut).to.eql(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Créer un contrat",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02T10:00:00\",\n    \"montantTotal\": 480.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "contrats"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"const id = json.idContrat || json.id;",
									"pm.environment.set(\"contratId\", id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
